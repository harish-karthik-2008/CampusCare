generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           Role            @default(STUDENT)
  department     String?
  phone          String?
  avatar         String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  assignedItems  Complaint[]     @relation("AdminAssignments")
  complaints     Complaint[]     @relation("StudentComplaints")
  feedbacks      Feedback[]
  notifications  Notification[]
  resolutionLogs ResolutionLog[]

  @@index([email])
  @@index([role])
}

model Category {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  icon        String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  complaints  Complaint[]

  @@index([name])
}

model Complaint {
  id               String          @id @default(cuid())
  complaintNumber  String          @unique
  studentId        String
  categoryId       String
  assignedAdminId  String?
  title            String
  description      String
  locationBuilding String
  locationBlock    String?
  locationRoom     String?
  priority         Priority        @default(NORMAL)
  status           ComplaintStatus @default(PENDING)
  attachmentUrl    String?
  assignedTeam     String?
  resolutionNote   String?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  assignedAdmin    User?           @relation("AdminAssignments", fields: [assignedAdminId], references: [id])
  category         Category        @relation(fields: [categoryId], references: [id])
  student          User            @relation("StudentComplaints", fields: [studentId], references: [id], onDelete: Cascade)
  feedback         Feedback?
  notifications    Notification[]
  resolutionLogs   ResolutionLog[]

  @@index([assignedAdminId])
  @@index([categoryId])
  @@index([complaintNumber])
  @@index([priority])
  @@index([status])
  @@index([studentId])
}

model ResolutionLog {
  id          String           @id @default(cuid())
  complaintId String
  actorId     String
  action      ResolutionAction
  note        String?
  createdAt   DateTime         @default(now())
  actor       User             @relation(fields: [actorId], references: [id])
  complaint   Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([complaintId])
  @@index([createdAt])
}

model Notification {
  id          String     @id @default(cuid())
  userId      String
  complaintId String?
  title       String
  message     String
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  readAt      DateTime?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([isRead])
  @@index([userId])
}

model Feedback {
  id          String    @id @default(cuid())
  complaintId String    @unique
  studentId   String
  rating      Int       @db.SmallInt
  comment     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([studentId])
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  NORMAL
  HIGH
  CRITICAL
}

enum ResolutionAction {
  SUBMITTED
  REVIEWED
  ASSIGNED
  STATUS_CHANGE
  RESOLVED
  CLOSED
  REOPENED
}

enum Role {
  STUDENT
  ADMIN
}
