// Prisma schema for CampusCare
// Smart Campus Complaint & Resolution Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           String          @default("STUDENT") // "STUDENT" | "ADMIN"
  department     String?
  phone          String?
  avatar         String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  complaints     Complaint[]     @relation("StudentComplaints")
  assignedItems  Complaint[]     @relation("AdminAssignments")
  resolutionLogs ResolutionLog[]
  notifications  Notification[]
  feedbacks      Feedback[]
}

model Category {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  icon        String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  complaints  Complaint[]
}

model Complaint {
  id               String          @id @default(cuid())
  complaintNumber  String          @unique // e.g. CC-1001
  studentId        String
  student          User            @relation("StudentComplaints", fields: [studentId], references: [id])
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id])
  title            String
  description      String
  locationBuilding String
  locationBlock    String?
  locationRoom     String?
  priority         String          @default("NORMAL") // "NORMAL" | "HIGH" | "CRITICAL"
  status           String          @default("PENDING") // "PENDING" | "IN_PROGRESS" | "RESOLVED" | "CLOSED"
  attachmentUrl    String?
  assignedTeam     String?         // "IT Team", "Maintenance Team", "Electrical Team", etc.
  assignedAdminId  String?
  assignedAdmin    User?           @relation("AdminAssignments", fields: [assignedAdminId], references: [id])
  resolutionNote   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  resolvedAt       DateTime?
  closedAt         DateTime?

  resolutionLogs   ResolutionLog[]
  notifications    Notification[]
  feedback         Feedback?
}

model ResolutionLog {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User      @relation(fields: [actorId], references: [id])
  action      String    // "SUBMITTED" | "REVIEWED" | "ASSIGNED" | "STATUS_CHANGE" | "RESOLVED" | "CLOSED" | "REOPENED"
  note        String?
  createdAt   DateTime  @default(now())
}

model Notification {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaintId String?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  title       String
  message     String
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

model Feedback {
  id          String    @id @default(cuid())
  complaintId String    @unique
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation(fields: [studentId], references: [id])
  rating      Int       // 1 to 5
  comment     String?
  createdAt   DateTime  @default(now())
}
