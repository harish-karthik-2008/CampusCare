# ===================================================
# CampusCare Environment Variables Template
# Add these in Vercel Dashboard -> Project Settings -> Environment Variables
# ===================================================

# 1. Supabase PostgreSQL Connection Strings
# Transaction pooler connection URL (port 6543) - used by Next.js app queries
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (port 5432) - used by Prisma CLI migrations & db push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. JWT Authentication Secret (32+ characters)
JWT_SECRET="campuscare-production-jwt-secret-key-32chars"

# 3. Environment Mode
NODE_ENV="production"
